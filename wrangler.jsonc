/**
 * Cloudflare Pages configuration (project: crisis-resources, deployed from GitHub on push to master).
 * https://developers.cloudflare.com/pages/functions/wrangler-configuration/
 *
 * Static site: ./build (Docusaurus). Pages Functions in ./functions:
 *   _middleware.js  Markdown negotiation (Accept: text/markdown) + Link discovery headers
 *   mcp/            MCP server at /mcp (docusaurus-plugin-mcp-server)
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "crisis-resources",
	"pages_build_output_dir": "./build",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"NODE_VERSION": "24"
	}
}
